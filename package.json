{
  "name": "myvsread",
  "displayName": "MyVsRead",
  "publisher": "your-publisher-name",
  "description": "an extension to read your files LOL",
  "version": "0.0.1",
  "icon": "media/icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/myvsread.git"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:myvsread.encryptFile",
    "onCommand:myvsread.decryptFile",
    "onView:myvsread.sidePanel",
    "onCommand:myvsread.showSidePanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "myvsread.encryptFile",
        "title": "MyVsRead: Encrypt Current File"
      },
      {
        "command": "myvsread.decryptFile",
        "title": "MyVsRead: Decrypt Current File"
      },
      {
        "command": "myvsread.showSidePanel",
        "title": "MyVsRead: Show Side Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myvsread-sidebar",
          "title": "MyVSRead",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "myvsread-sidebar": [
        {
          "id": "myvsread.sidePanel",
          "name": "Side Panel",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
